# Required: the full remote endpoint URL, ending in /generate.
# Kaggle: copy the current trycloudflare URL printed by the server, then append /generate.
LOCAL_SERVER_URL=https://YOUR-CURRENT-TUNNEL.trycloudflare.com/generate
REMOTE_API_KEY=replace-with-the-same-API_KEY-configured-on-Kaggle
DATABASE_PATH=data/college.db
SCHEMA_PATH=schema.sql
REMOTE_TIMEOUT_SECONDS=115
MAX_NEW_TOKENS=700
MODEL_TEMPERATURE=0.1
MAX_QUESTION_CHARS=2000
MAX_RESULT_ROWS=200
MAX_REPAIR_ATTEMPTS=1

# Optional Gemini fallback. Disabled by default to avoid silently changing model.
ENABLE_GEMINI_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
